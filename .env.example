# Worksync runtime configuration.
# Every variable is OPTIONAL — the app boots with sane defaults when this
# file is absent. Copy to .env only if you want to override something.

# Port the HTTP server binds (default 8080)
PORT=

# Bind address (default 0.0.0.0)
HOST=

# Datasource URL. Empty => embedded H2 database at ./data/worksync
# (PostgreSQL-compatible mode). To use PostgreSQL, set a full jdbc URL:
# DATABASE_URL=jdbc:postgresql://localhost:5432/worksync
DATABASE_URL=

# DB credentials (defaults: sa/"" for H2, postgres/postgres for PostgreSQL)
DB_USER=
DB_PASSWORD=

# JDBC driver class (auto-selected from DATABASE_URL when empty)
JDBC_DRIVER=

# Session/csrf signing secret. Empty => built-in dev-only fallback.
# Generate one for real deployments:  openssl rand -hex 32
SESSION_SECRET=

# Set to "true" to mark session cookies Secure (only under HTTPS)
COOKIE_SECURE=
